# Secret for signing dev JWTs (HS256). In production it comes from a secret manager.
JWT_SECRET=change-me-dev-secret

# task-service
HTTP_ADDR=:8080
GRPC_ADDR=:9090
# MOCK: both DSNs point at one PostgreSQL; in production REPLICA_DSN is a read replica.
PRIMARY_DSN=postgres://tasks:tasks@localhost:55432/tasks?sslmode=disable
REPLICA_DSN=postgres://tasks:tasks@localhost:55432/tasks?sslmode=disable
REDIS_ADDR=localhost:6379
CACHE_ENABLED=true
GROUP_SERVICE_ADDR=localhost:9091

# group-service
GROUP_GRPC_ADDR=:9091
INVITE_BASE_URL=http://localhost:8080/v1/invite-links/
FAULT_UNAVAILABLE_RATE=0
FAULT_DELAY_MS=0
